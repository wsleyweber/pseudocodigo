{
  "name": "pseudocodigo-js",
  "version": "1.0.0",
  "description": "Interpretador de pseudocódigo (portugol) em Node.js para o ensino de lógica de programação",
  "main": "src/index.js",
  "bin": { "pseudo": "bin/pseudo.js" },
  "scripts": {
    "start": "node bin/pseudo.js",
    "verificar": "node bin/pseudo.js --verificar",
    "test": "node --test test/interpretador.test.js test/recursos.test.js",
    "build:web": "node scripts/build-web.js",
    "build:cli": "node scripts/build-cli.js"
  },
  "engines": { "node": ">=24" },
  "license": "MIT"
}
