{
  "name": "pseudocodigo-js",
  "version": "1.0.2",
  "description": "Interpretador de pseudocódigo (portugol) em Node.js para o ensino de lógica de programação",
  "keywords": [
    "portugol",
    "pseudocodigo",
    "interpretador",
    "logica-de-programacao",
    "ensino",
    "educacao"
  ],
  "homepage": "https://wsleyweber.github.io/pseudocodigo/",
  "bugs": {
    "url": "https://github.com/wsleyweber/pseudocodigo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsleyweber/pseudocodigo.git"
  },
  "author": "Wesley Weber",
  "license": "MIT",
  "main": "src/index.js",
  "bin": {
    "pseudo": "bin/pseudo.js"
  },
  "files": [
    "bin/",
    "src/"
  ],
  "scripts": {
    "start": "node bin/pseudo.js",
    "verificar": "node bin/pseudo.js --verificar",
    "test": "node --test test/interpretador.test.js test/recursos.test.js",
    "build:web": "node scripts/build-web.js"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
